{
  "name": "@local/dsh-side-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A right-sidebar chat that answers questions about the current session's conversation.",
  "author": "BornCode (https://github.com/borncode-app)",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/borncode-app/dsh-side-chat.git" },
  "homepage": "https://github.com/borncode-app/dsh-side-chat#readme",
  "bugs": { "url": "https://github.com/borncode-app/dsh-side-chat/issues" },
  "keywords": ["dsh","deepseek-harness","dsh-plugin","chat","sidebar","session","context","qa"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
